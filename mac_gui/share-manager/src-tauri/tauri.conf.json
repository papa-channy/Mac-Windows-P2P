{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "share-manager",
  "version": "0.3.7",
  "identifier": "com.shareguard.share-manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mac-Window 공유",
        "width": 1320,
        "height": 880,
        "minWidth": 980,
        "minHeight": 600,
        "theme": "Light",
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.macos.plist"
    },
    "resources": [
      "../../../RELEASES.json"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3NDU3Qzg2Mjg5QTZCRjYKUldUMmE1b29obnhGcDJKcUppMGJaMFVQa2NBTlloVmpyajY2c0tUU25aK0UxVWpsS0drRll6OFQK",
      "endpoints": [
        "https://github.com/papa-channy/Mac-Windows-P2P/releases/latest/download/latest.json"
      ]
    }
  }
}
