{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "share-manager",
  "version": "0.1.0",
  "identifier": "com.shareguard.share-manager",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mac-Window 공유",
        "width": 1800,
        "height": 1520,
        "minWidth": 880,
        "minHeight": 520,
        "theme": "Light",
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
