# Contains mutation testing data
**/mutants.out*/

# RustRover / JetBrains
#.idea/

# Tauri auto-generated
**/src-tauri/gen/
**/src-tauri/target/

# Swift Package Manager
.build/
.swiftpm/
DerivedData/
*.xcodeproj/

# Node
node_modules/

# Build outputs (this project)
**/bin/
**/share-manager.exe

# Project-internal checksums and backups
*.sha256
*.bak-*

# OS junk
.DS_Store
._*
Thumbs.db
desktop.ini
